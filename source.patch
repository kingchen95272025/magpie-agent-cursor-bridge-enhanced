+/// Set from `CURSOR_BRIDGE_SUBAGENT_MODE`. In sync mode every Task call is
+/// forced to `run_in_background = false`, so the client runs the subagent
+/// inline and the parent turn waits for its result. Async mode leaves the
+/// model's intent untouched and the bridge wakes the parent on completion.
+static SUBAGENT_SYNC: OnceLock<bool> = OnceLock::new();
+
+pub fn set_subagent_sync(sync: bool) {
+    let _ = SUBAGENT_SYNC.set(sync);
+}
+
+pub fn subagent_sync() -> bool {
+    *SUBAGENT_SYNC.get().unwrap_or(&false)
+}
