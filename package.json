{
  "name": "magpie-agent-cursor-bridge",
  "version": "0.2.40",
  "type": "module",
  "description": "No Cursor subscription needed — Magpie models inside Cursor",
  "license": "MIT",
  "main": "./control/host.js",
  "magpie": {
    "agent": "./agent.js",
    "page": {
      "title": "Cursor Bridge",
      "titles": {
        "zh": "Cursor 桥接控制台",
        "zh-TW": "Cursor 橋接控制台"
      },
      "file": "ui/console.html",
      "icon": "ui/cursor.svg"
    },
    "actions": [
      {
        "id": "console",
        "menu": "agent",
        "title": "Bridge console",
        "titles": {
          "zh": "桥接控制台",
          "zh-TW": "橋接控制台"
        }
      }
    ],
    "options": {
      "controlPort": 3580
    },
    "icon": "data:image/svg+xml;base64,"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "status": "bash setup.command status",
    "setup": "bash setup.command",
    "uninstall": "bash setup.command uninstall"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "files": [
    "agent.js",
    "agent-platform.js",
    "version.js",
    "bridge.js",
    "install.js",
    "setup.command",
    "lib",
    "control",
    "ui",
    "bin/cursor-magpie-bridge",
    "bin/darwin-x64",
    "bin/win32-x64",
    "bin/linux-x64",
    "bin/linux-arm64",
    "integrity.json",
    "source.patch",
    "source-linux.patch",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "scripts",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "magpie",
    "magpie-agent",
    "cursor",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingchen95272025/magpie-agent-cursor-bridge-enhanced.git"
  },
  "homepage": "https://github.com/kingchen95272025/magpie-agent-cursor-bridge-enhanced#readme",
  "bugs": {
    "url": "https://github.com/nodlles/magpie-agent-cursor-bridge/issues"
  }
}
